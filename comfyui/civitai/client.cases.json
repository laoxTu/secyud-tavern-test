{
  "url": "https://civitai.com",
  "extract": [
    {
      "name": "单文件：按 fileInfo.type 映射模型类型",
      "meta": {
        "description": "a lora for testing",
        "baseModel": "SD 1.5",
        "downloadUrl": "https://civitai.com/api/download/models/100",
        "images": [
          {
            "url": "https://image.civitai.com/one.jpeg",
            "width": 512
          },
          {
            "url": "https://image.civitai.com/two.jpeg",
            "width": 768
          }
        ],
        "files": [
          {
            "id": 1,
            "name": "my_lora.safetensors",
            "type": "LORA",
            "primary": true
          }
        ]
      },
      "modelMeta": {
        "name": "My Lora",
        "type": "LORA"
      },
      "url": "https://civitai.com/model-versions/100",
      "expected": [
        {
          "id": null,
          "code": "my_lora.safetensors",
          "name": "My Lora",
          "type": "lora",
          "path": "my_lora.safetensors",
          "cover": "https://image.civitai.com/one.jpeg",
          "model": "SD 1.5",
          "download": "https://civitai.com/api/download/models/100",
          "html": "a lora for testing",
          "url": "https://civitai.com/model-versions/100",
          "importer": "civitai"
        }
      ]
    },
    {
      "name": "多文件：每个文件各生成一个模型，文件名作为 code",
      "meta": {
        "description": "checkpoint with two files",
        "baseModel": "SDXL 1.0",
        "downloadUrl": "https://civitai.com/api/download/models/200",
        "images": [
          {
            "url": "https://image.civitai.com/cover.jpeg"
          }
        ],
        "files": [
          {
            "id": 1,
            "name": "one.safetensors",
            "type": "Model"
          },
          {
            "id": 2,
            "name": "two.safetensors",
            "type": "Model"
          }
        ]
      },
      "modelMeta": {
        "name": "Checkpoint",
        "type": "Checkpoint"
      },
      "url": "u",
      "expected": [
        {
          "id": null,
          "code": "one.safetensors",
          "name": "Checkpoint",
          "type": "checkpoint",
          "path": "one.safetensors",
          "cover": "https://image.civitai.com/cover.jpeg",
          "model": "SDXL 1.0",
          "download": "https://civitai.com/api/download/models/200",
          "html": "checkpoint with two files",
          "url": "u",
          "importer": "civitai"
        },
        {
          "id": null,
          "code": "two.safetensors",
          "name": "Checkpoint",
          "type": "checkpoint",
          "path": "two.safetensors",
          "cover": "https://image.civitai.com/cover.jpeg",
          "model": "SDXL 1.0",
          "download": "https://civitai.com/api/download/models/200",
          "html": "checkpoint with two files",
          "url": "u",
          "importer": "civitai"
        }
      ]
    },
    {
      "name": "没有图片时 cover 为 null",
      "meta": {
        "description": "",
        "baseModel": "SD 1.5",
        "downloadUrl": "https://civitai.com/api/download/models/300",
